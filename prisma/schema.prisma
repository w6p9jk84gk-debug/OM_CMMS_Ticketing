generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  REPORTER
  TECHNICIAN
  COORDINATOR
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum HistoryKind {
  CREATED
  STATUS
  ASSIGNMENT
  WORK
  COMMENT
}

model Location {
  id          String   @id
  name        String
  description String
  assets      Asset[]
  tickets     Ticket[]
}

model Asset {
  id         String   @id
  name       String
  code       String   @unique
  locationId String
  category   String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  tickets    Ticket[]
}

model Person {
  id         String         @id
  name       String
  role       Role
  initials   String
  specialty  String
  reported   Ticket[]       @relation("Reporter")
  assigned   Ticket[]       @relation("Assignee")
  comments   Comment[]
  workLogs   WorkLog[]
  history    HistoryEvent[]
}

model Ticket {
  id          String         @id
  number      String         @unique
  title       String
  description String
  locationId  String
  assetId     String
  priority    Priority
  status      TicketStatus
  reporterId  String
  assigneeId  String?
  createdAt   DateTime
  updatedAt   DateTime
  dueAt       DateTime
  closedAt    DateTime?
  location    Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  asset       Asset          @relation(fields: [assetId], references: [id], onDelete: Restrict)
  reporter    Person         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee    Person?        @relation("Assignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  comments    Comment[]
  workLogs    WorkLog[]
  history     HistoryEvent[]

  @@index([status, dueAt])
  @@index([assetId])
  @@index([assigneeId])
}

model Comment {
  id        String   @id
  ticketId  String
  authorId  String
  text      String
  createdAt DateTime
  ordinal   Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author    Person   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([ticketId, ordinal])
}

model WorkLog {
  id        String   @id
  ticketId  String
  authorId  String
  measure   String
  minutes   Int
  createdAt DateTime
  ordinal   Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author    Person   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([ticketId, ordinal])
}

model HistoryEvent {
  id        String      @id
  ticketId  String
  actorId   String
  text      String
  createdAt DateTime
  kind      HistoryKind
  ordinal   Int
  ticket    Ticket      @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor     Person      @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([ticketId, ordinal])
}

model Counter {
  id         String @id
  nextNumber Int
}
